@{
    ViewData["Title"] = "Error";
    Layout = "_AuthLayout";
}
<div class="auth-wrapper">
    <div class="auth-card text-center">
        <img src="~/images/logo.jpg" alt="ITS ResFix" class="auth-logo-img" />
        <h1 class="h4 mt-3">Something went wrong</h1>
        <p class="text-muted">An unexpected error occurred. Please try again.</p>
        <a asp-controller="Account" asp-action="Login" class="btn btn-rf-primary">Go back</a>
    </div>
</div>
