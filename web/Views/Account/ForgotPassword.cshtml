@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_AuthLayout";
    var sent = ViewBag.Sent == true;
}
<div class="auth-brand">
    <img src="~/images/logo.jpg" alt="ITS ResFix" class="auth-logo-img" />
    <h1>ITS ResFix</h1>
    <p>Staff Portal</p>
</div>

<h2 style="font-size:1.1rem;font-weight:700;color:var(--rf-navy);margin:0 0 6px;">Forgot Password</h2>

@if (sent)
{
    <div class="alert alert-success py-2 small" role="alert">
        <i class="bi bi-check-circle me-1"></i>
        If that email address or number belongs to a staff account, we have sent a link to reset the password.
        Check your inbox (and spam folder). The link works once and expires in 30 minutes.
    </div>
}
else
{
    <p style="font-size:.88rem;color:var(--rf-muted);margin:0 0 18px;">
        Enter the email address or cellphone number saved on your account. We will send you a link to choose a new password.
    </p>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger py-2 small" role="alert">
            <i class="bi bi-exclamation-circle me-1"></i>@ViewData.ModelState.Values.SelectMany(v => v.Errors).First().ErrorMessage
        </div>
    }

    <form asp-action="ForgotPassword" method="post" novalidate>
        <div class="mb-3">
            <label asp-for="Identifier" class="form-label"></label>
            <div class="input-icon">
                <i class="bi bi-envelope"></i>
                <input asp-for="Identifier" class="form-control" placeholder="you@example.com or 071 234 5678" autocomplete="username" autofocus />
            </div>
        </div>
        <button type="submit" class="btn btn-rf-primary w-100 mb-3">Send reset link</button>
    </form>
}

<a asp-action="Login" class="btn btn-rf-outline w-100">
    <i class="bi bi-arrow-left me-1"></i> Back to Sign In
</a>
