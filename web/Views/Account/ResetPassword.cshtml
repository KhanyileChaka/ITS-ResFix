@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = "_AuthLayout";
    var invalid = ViewBag.Invalid == true;
}
<div class="auth-brand">
    <img src="~/images/logo.jpg" alt="ITS ResFix" class="auth-logo-img" />
    <h1>ITS ResFix</h1>
    <p>Staff Portal</p>
</div>

<h2 style="font-size:1.1rem;font-weight:700;color:var(--rf-navy);margin:0 0 6px;">Choose a new password</h2>

@if (invalid)
{
    <div class="alert alert-danger py-2 small" role="alert">
        <i class="bi bi-exclamation-circle me-1"></i>
        This reset link is invalid or has expired. Request a new one.
    </div>
    <a asp-action="ForgotPassword" class="btn btn-rf-primary w-100 mb-2">Request a new link</a>
}
else
{
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger py-2 small" role="alert">
            <i class="bi bi-exclamation-circle me-1"></i>@ViewData.ModelState.Values.SelectMany(v => v.Errors).First().ErrorMessage
        </div>
    }
    <form asp-action="ResetPassword" method="post" novalidate>
        <input type="hidden" asp-for="Token" />
        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label"></label>
            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" autofocus />
            <div class="form-text">At least 8 characters.</div>
        </div>
        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
        </div>
        <button type="submit" class="btn btn-rf-primary w-100 mb-3">Save new password</button>
    </form>
}
<a asp-action="Login" class="btn btn-rf-outline w-100">
    <i class="bi bi-arrow-left me-1"></i> Back to Sign In
</a>
