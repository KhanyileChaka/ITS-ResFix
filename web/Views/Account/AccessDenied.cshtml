@{
    ViewData["Title"] = "Access Denied";
    Layout = "_AuthLayout";
}
<div class="auth-wrapper">
    <div class="auth-card text-center">
        <img src="~/images/logo.jpg" alt="ITS ResFix" class="auth-logo-img" />
        <h1 class="h4 mt-3">Access denied</h1>
        <p class="text-muted">You don't have permission to view that page.</p>
        <a asp-controller="Account" asp-action="Login" class="btn btn-rf-primary">Back to my dashboard</a>
    </div>
</div>
