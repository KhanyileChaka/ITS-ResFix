@model WorkerProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}
@if (ViewBag.MustChange == true)
{
    <div class="warning-banner mb-3"><i class="bi bi-shield-lock-fill me-1"></i> You are using a one-time password. Choose a new password below before you continue.</div>
}
<div class="rf-card rf-card-padded mb-4">
    <div class="row g-4 align-items-start">
        <div class="col-md-3 text-center">
            <div class="profile-avatar"><i class="bi bi-person"></i></div>
            <div class="profile-name">@Model.FullName</div>
            <div class="profile-role">Maintenance Worker@(Model.Specialisation is null ? "" : $" ({Model.Specialisation})")</div>
            <button type="button" class="btn btn-rf-primary mt-3" data-bs-toggle="modal" data-bs-target="#editProfileModal">
                Edit Profile
            </button>
        </div>
        <div class="col-md-9">
            <div class="row g-4">
                <div class="col-sm-6">
                    <div class="field-label">Email</div>
                    <div class="field-value">@Model.Email</div>
                </div>
                <div class="col-sm-6">
                    <div class="field-label">Phone</div>
                    <div class="field-value">@(Model.Phone ?? "Not set")</div>
                </div>
                <div class="col-sm-6">
                    <div class="field-label">Specialisation</div>
                    <div class="field-value">@(Model.Specialisation ?? "General")</div>
                </div>
                <div class="col-sm-6">
                    <div class="field-label">Assigned Accommodation</div>
                    <div class="field-value">@(Model.AssignedAccommodation ?? "Not set")</div>
                </div>
                <div class="col-sm-6">
                    <div class="field-label">Auto-Assignment</div>
                    @if (Model.AutoAssignmentEnabled)
                    {
                        <span class="rf-badge status-resolved">Enabled</span>
                    }
                    else
                    {
                        <span class="rf-badge status-unknown">Not configured</span>
                    }
                </div>
                <div class="col-sm-6">
                    <div class="field-label">Response Rate</div>
                    @if (Model.ResponseRate is int rate)
                    {
                        <span class="rate-value">@rate%</span> <span class="small ms-1">@DisplayHelper.RateLabel(rate)</span>
                    }
                    else
                    {
                        <span class="text-muted small">No completed jobs yet</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="rf-card rf-card-padded">
    <div class="d-flex justify-content-between align-items-baseline mb-3">
        <h2 class="card-heading mb-0"><i class="bi bi-key me-2 text-rf-navy"></i>Change Password</h2>
        <span class="form-hint">Use at least 8 characters.</span>
    </div>
    <form asp-action="ChangePassword" method="post" novalidate>
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="Password.CurrentPassword" class="form-label"></label>
                <div class="input-icon">
                    <i class="bi bi-lock"></i>
                    <input asp-for="Password.CurrentPassword" class="form-control" placeholder="Enter current password" autocomplete="current-password" />
                </div>
                <span asp-validation-for="Password.CurrentPassword" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Password.NewPassword" class="form-label"></label>
                <div class="input-icon">
                    <i class="bi bi-lock"></i>
                    <input asp-for="Password.NewPassword" class="form-control" placeholder="Enter new password" autocomplete="new-password" />
                </div>
                <span asp-validation-for="Password.NewPassword" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Password.ConfirmPassword" class="form-label"></label>
                <div class="input-icon">
                    <i class="bi bi-lock"></i>
                    <input asp-for="Password.ConfirmPassword" class="form-control" placeholder="Confirm new password" autocomplete="new-password" />
                </div>
                <span asp-validation-for="Password.ConfirmPassword" class="text-danger small"></span>
            </div>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
            <span class="small">Your password will be updated immediately.</span>
            <button type="submit" class="btn btn-rf-primary px-4">Change Password</button>
        </div>
    </form>
</div>

<div class="modal fade" id="editProfileModal" tabindex="-1" aria-labelledby="editProfileTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="EditProfile" method="post" class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="editProfileTitle">Edit Profile</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label asp-for="Edit.FullName" class="form-label"></label>
                    <input asp-for="Edit.FullName" class="form-control" />
                </div>
                <div>
                    <label asp-for="Edit.Phone" class="form-label"></label>
                    <input asp-for="Edit.Phone" class="form-control" placeholder="071 234 5678" inputmode="tel" />
                </div>
                <p class="form-hint mt-3 mb-0">Email, specialisation and accommodation are managed by the residence manager.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-rf-primary">Save Changes</button>
            </div>
        </form>
    </div>
</div>
