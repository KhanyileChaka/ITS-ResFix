@{
    var isManager = User.IsInRole(Roles.Manager);
    var userName = User.Identity?.Name ?? "Staff";
    var firstName = userName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? userName;
    var homeController = isManager ? "Manager" : "Worker";
    var theme = isManager ? "theme-manager" : "theme-worker";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/images/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/images/favicon-16.png" />
    <link rel="shortcut icon" href="~/favicon.ico" />
    <link rel="apple-touch-icon" href="~/images/apple-touch-icon.png" />
    <title>@ViewData["Title"] · ITS ResFix</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="staff-body @theme">

    <header class="topbar">
        <button class="btn btn-link topbar-toggle d-lg-none" type="button" data-sidebar-toggle aria-label="Open menu">
            <i class="bi bi-list"></i>
        </button>
        <a asp-controller="@homeController" asp-action="Dashboard" class="topbar-brand">
            <img src="~/images/logo.jpg" alt="ITS ResFix" style="width:36px;height:36px;border-radius:9px;object-fit:cover;background:#fff;" />
            <span class="topbar-title-text">ITS ResFix</span>
            @if (!isManager)
            {
                <span class="topbar-portal-tag">PORTAL</span>
            }
        </a>
        <div class="topbar-user ms-auto">
            <span class="d-none d-sm-inline" style="font-size:.9rem;">Welcome, @firstName</span>
            <span class="avatar">@DisplayHelper.Initials(userName)</span>
        </div>
    </header>

    <aside class="sidebar" id="sidebar">
        <button type="button" class="sidebar-close" data-sidebar-close aria-label="Close menu"><i class="bi bi-x-lg"></i></button>
        <div class="sidebar-user">
            <span class="avatar avatar-lg">@DisplayHelper.Initials(userName)</span>
            <div class="sidebar-user-text">
                <div class="sidebar-user-name">@userName</div>
                <div class="sidebar-user-role">@(isManager ? "Residence manager" : "Maintenance worker")</div>
            </div>
        </div>
        <nav class="sidebar-nav pt-2">
            @if (isManager)
            {
                <partial name="_ManagerNav" />
            }
            else
            {
                <partial name="_WorkerNav" />
            }
        </nav>

        <form asp-controller="Account" asp-action="Logout" method="post" class="sidebar-footer">
            <button type="submit" class="sidebar-link w-100 border-0 bg-transparent text-start">
                <i class="bi bi-box-arrow-right"></i><span>Logout</span>
            </button>
        </form>
    </aside>
    <div class="sidebar-backdrop" data-sidebar-close></div>

    <main class="main">
        <div class="content">
            @if (ViewData["CustomHeader"] is not true)
            {
                <h1 class="page-title">@ViewData["Title"]</h1>
            }
            @if (TempData["Success"] is string success)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle me-2"></i>@success
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>@error
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @RenderBody()
        </div>
    </main>

    <nav class="bottom-nav" aria-label="@(isManager ? "Manager" : "Worker") navigation">
        @if (isManager)
        {
            <partial name="_ManagerBottomNav" />
        }
        else
        {
            <partial name="_WorkerBottomNav" />
        }
    </nav>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
