<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/images/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/images/favicon-16.png" />
    <link rel="shortcut icon" href="~/favicon.ico" />
    <link rel="apple-touch-icon" href="~/images/apple-touch-icon.png" />
    <title>@ViewData["Title"] · ITS ResFix</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="auth-body auth-body-light">
    <div class="auth-split">
        <aside class="auth-side" aria-hidden="true">
            <div class="auth-side-inner">
                <div class="auth-side-brand">
                    <span class="auth-side-logo"><img src="~/images/logo.jpg" alt="" /></span>
                    <span>ITS ResFix</span>
                </div>
                <div class="auth-side-copy">
                    <h2>Residence maintenance, handled.</h2>
                    <p>One place for managers and workers to receive, assign and close student requests on time.</p>
                    <ul class="auth-points">
                        <li><i class="bi bi-diagram-3"></i><div><strong>Automatic assignment</strong><span>Each request goes to the right worker the moment it arrives.</span></div></li>
                        <li><i class="bi bi-stopwatch"></i><div><strong>48-hour timers</strong><span>Nothing is forgotten. Overdue jobs are flagged straight away.</span></div></li>
                        <li><i class="bi bi-stars"></i><div><strong>AI-checked requests</strong><span>Fewer false alarms, with emergencies pushed to the top.</span></div></li>
                    </ul>
                </div>
                <div class="auth-side-foot">&copy; 2026 ITS ResFix</div>
            </div>
        </aside>
        <main class="auth-panel">
            <div class="auth-panel-inner">
                @RenderBody()
            </div>
        </main>
    </div>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
