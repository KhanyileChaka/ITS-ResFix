@* One dialog for every level of taking someone out of the system. Filled in by site.js from the button that opened it. *@
<div class="modal fade pm-modal" id="accessModal" tabindex="-1" aria-labelledby="accessTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-fullscreen-sm-down">
        <form asp-controller="Manager" asp-action="ChangeAccess" method="post" class="modal-content" novalidate>
            <input type="hidden" name="kind" id="accessKind" />
            <input type="hidden" name="id" id="accessId" />
            <div class="modal-header pm-modal-head">
                <span class="pm-modal-icon"><i class="bi bi-shield-lock"></i></span>
                <div class="pm-modal-titles">
                    <h2 class="modal-title" id="accessTitle">Manage access</h2>
                    <p id="accessSub">Choose what happens to this person.</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="access-options">
                    <label class="access-option" data-when="active">
                        <input type="radio" name="action" value="suspend" />
                        <span><strong>Suspend</strong><small>Block sign-in for now, for example while something is sorted out. You can restore them exactly as they were.</small></span>
                    </label>
                    <label class="access-option" data-when="active suspended">
                        <input type="radio" name="action" value="remove" />
                        <span><strong>Remove</strong><small>They have left. They are signed out and get no new work. Their history is kept. If you bring them back, they set up again.</small></span>
                    </label>
                    <label class="access-option" data-when="suspended removed">
                        <input type="radio" name="action" value="restore" />
                        <span><strong>Restore access</strong><small data-restore-note>They can sign in again.</small></span>
                    </label>
                    <label class="access-option access-option-danger" data-when="removed">
                        <input type="radio" name="action" value="delete" />
                        <span><strong>Delete permanently</strong><small>Erases the person for good. Only possible when they have no requests on record, and it cannot be undone.</small></span>
                    </label>
                </div>

                <div class="mt-3 d-none" data-access-block="reason">
                    <label for="accessReason" class="form-label">Reason <span class="text-muted fw-normal">(optional, for your records)</span></label>
                    <input name="reason" id="accessReason" class="form-control" maxlength="200" autocomplete="off" placeholder="For example: left the residence, or under review" />
                </div>
                <div class="form-check mt-3 d-none" data-access-block="jobs">
                    <input class="form-check-input" type="checkbox" name="releaseJobs" id="accessJobs" value="true" checked />
                    <label class="form-check-label" for="accessJobs">Send their <span id="accessJobCount">0</span> open job(s) back to the queue so you can give them to someone else</label>
                </div>
                <div class="mt-3 d-none" data-access-block="confirm">
                    <label for="accessConfirm" class="form-label">Type <strong id="accessConfirmName"></strong> to confirm</label>
                    <input name="confirmName" id="accessConfirm" class="form-control" autocomplete="off" />
                </div>
            </div>
            <div class="modal-footer pm-modal-foot">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-rf-primary" id="accessGo" disabled><i class="bi bi-check-lg"></i> Apply</button>
            </div>
        </form>
    </div>
</div>
