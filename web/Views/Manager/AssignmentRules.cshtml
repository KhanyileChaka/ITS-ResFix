@model AssignmentRulesViewModel
@{
    ViewData["Title"] = "Auto-Assignment Rules";
    ViewData["CustomHeader"] = true;
    var company = string.IsNullOrWhiteSpace(Model.CompanyName) ? "No external company set up" : Model.CompanyName;
}

<div class="page-header">
    <div>
        <h1 class="page-title mb-1">Auto-Assignment Rules</h1>
        <p class="page-subtitle">Which worker takes each kind of complaint the moment it is approved.</p>
    </div>
    <button type="button" class="btn btn-rf-primary btn-sm ms-auto" data-bs-toggle="modal" data-bs-target="#addRuleModal">
        <i class="bi bi-plus-lg"></i> Add rule
    </button>
</div>

<div class="info-banner mb-3">
    <i class="bi bi-info-circle-fill"></i>
    Complaints go to the internal worker first. If the 48-hour timer runs out, you can reassign them to the external company.
</div>

@if (Model.Rules.Count == 0)
{
    <div class="rf-card">
        <div class="empty-state">
            <i class="bi bi-diagram-3"></i>
            <p>No rules yet. Choose <strong>Add rule</strong> to set up auto-assignment.</p>
        </div>
    </div>
}
else
{
    <div class="pm-cards pm-cards-wide">
        @foreach (var r in Model.Rules)
        {
            <div class="pm-card">
                <div class="pm-card-top">
                    <span class="pm-row-icon"><i class="bi bi-tag"></i></span>
                    <div class="pm-card-id">
                        <div class="pm-card-name">@r.CategoryName</div>
                        <div class="pm-card-sub">Category</div>
                    </div>
                    <span class="rf-badge @(r.Priority == "High" ? "priority-high" : "priority-normal")">@r.Priority priority</span>
                </div>
                <div class="pm-flow">
                    <div class="pm-flow-step">
                        <span class="avatar pm-avatar">@DisplayHelper.Initials(r.WorkerName)</span>
                        <div>
                            <div class="pm-flow-title">@r.WorkerName</div>
                            <div class="pm-flow-sub">@(r.Specialisation ?? "Primary worker")</div>
                        </div>
                    </div>
                    <i class="bi bi-chevron-down pm-flow-arrow"></i>
                    <div class="pm-flow-step pm-flow-fallback">
                        <span class="pm-row-icon"><i class="bi bi-building"></i></span>
                        <div>
                            <div class="pm-flow-title">@company</div>
                            <div class="pm-flow-sub">Fallback if the timer expires</div>
                        </div>
                    </div>
                </div>
                <form asp-action="DeleteRule" method="post" data-confirm="Remove the rule for @r.CategoryName?">
                    <input type="hidden" name="ruleId" value="@r.RuleId" />
                    <button type="submit" class="btn btn-sm btn-outline-danger w-100"><i class="bi bi-trash"></i> Remove rule</button>
                </form>
            </div>
        }
    </div>
    <p class="small text-muted mt-3 mb-0">The 48-hour timer starts at assignment. No manual approval is needed; step in and reassign when a timer expires.</p>
}

<!-- Add rule dialog -->
<div class="modal fade pm-modal" id="addRuleModal" tabindex="-1" aria-labelledby="addRuleTitle" aria-hidden="true" @(ViewData.ModelState.IsValid ? "" : "data-auto-open")>
    <div class="modal-dialog modal-dialog-centered modal-fullscreen-sm-down">
        <form asp-action="AssignmentRules" method="post" class="modal-content" novalidate>
            <div class="modal-header pm-modal-head">
                <span class="pm-modal-icon"><i class="bi bi-diagram-3"></i></span>
                <div class="pm-modal-titles">
                    <h2 class="modal-title" id="addRuleTitle">Add or update a rule</h2>
                    <p>New complaints in this category go to the worker you choose.</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="CategoryId" class="form-label"></label>
                        <select asp-for="CategoryId" class="form-select" asp-items="@(new SelectList(Model.Categories, "CategoryId", "Name"))">
                            <option value="">Select a category</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="WorkerId" class="form-label"></label>
                        <select asp-for="WorkerId" class="form-select">
                            <option value="">Select a worker</option>
                            @foreach (var w in Model.Workers)
                            {
                                <option value="@w.WorkerId">@w.Name@(w.Specialisation is null ? "" : $" - {w.Specialisation}")</option>
                            }
                        </select>
                        <span asp-validation-for="WorkerId" class="text-danger small"></span>
                    </div>
                </div>
            </div>
            <div class="modal-footer pm-modal-foot">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-rf-primary"><i class="bi bi-check-lg"></i> Save rule</button>
            </div>
        </form>
    </div>
</div>
